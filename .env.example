# Copy to .env and fill in real values. Never commit .env.
# See docs/SECURITY.md for how each secret must be produced and stored.

# Environment: development | staging | production
APP_ENV=development

# Public base URL of this service (used to build webhook URLs).
PUBLIC_URL=http://localhost:8080

# PostgreSQL connection string.
DATABASE_URL=postgres://kazna:kazna@localhost:5432/kazna?sslmode=disable

# 32-byte key (hex or base64) for AES-256-GCM encryption of provider secrets.
# Generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=

# bcrypt hash of the admin password for the dashboard (Stage 6).
ADMIN_PASSWORD_HASH=

# Logging: debug | info | warn | error
LOG_LEVEL=info

# HTTP listen address for the API process.
HTTP_ADDR=:8080

# Number of concurrent worker jobs.
WORKER_CONCURRENCY=5

# Base interval for payment status polling.
PAYMENT_POLL_INTERVAL=30s

# --- Provider integration (see docs/VERIFICATION_HARNESS.md) ---
# Base URL of the YooKassa API. Point at the emulator on the verification stand.
YOOKASSA_API_URL=https://api.yookassa.ru
# How long a repeated provider idempotency key is treated as the same request.
# Shortened on the stand (e.g. 30s) so expiry tests do not wait a day.
PROVIDER_IDEMPOTENCY_WINDOW=24h

# Graceful shutdown timeout.
SHUTDOWN_TIMEOUT=15s

# --- Compose-only overrides ---
POSTGRES_USER=kazna
POSTGRES_PASSWORD=kazna
POSTGRES_DB=kazna
POSTGRES_PORT=5433
API_PORT=18080
